#index.html

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Responsive AJAX Website</title>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }

        header {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 20px;
        }

        header h1 {
            margin: 0;
        }

        nav {
            background-color: #555;
        }

        nav ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
        }

        nav li {
            margin: 0;
        }

        nav a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 15px 25px;
        }

        nav a:hover {
            background-color: #333;
        }

        #content {
            max-width: 900px;
            margin: 20px auto;
            padding: 30px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        #content h2 {
            color: #333;
        }

        @media (max-width: 768px) {

            nav ul {
                flex-direction: column;
                text-align: center;
            }

            nav a {
                padding: 12px;
            }

            #content {
                margin: 15px;
                padding: 20px;
            }

            header h1 {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>Responsive AJAX Website</h1>
    </header>

    <nav>
        <ul>
            <li><a href="#" id="home">Home</a></li>
            <li><a href="#" id="about">About</a></li>
            <li><a href="#" id="contact">Contact</a></li>
        </ul>
    </nav>

    <div id="content">
        <!-- AJAX content will be loaded here -->
    </div>

    <script src="script.js"></script>

</body>
</html>

#script.js

$(document).ready(function () {

    // Load Home page when website starts
    loadContent("home");

    // Home button
    $("#home").click(function (e) {
        e.preventDefault();
        loadContent("home");
    });

    // About button
    $("#about").click(function (e) {
        e.preventDefault();
        loadContent("about");
    });

    // Contact button
    $("#contact").click(function (e) {
        e.preventDefault();
        loadContent("contact");
    });

});

// Function to load HTML content using AJAX
function loadContent(page) {

    $.ajax({
        url: page + ".html",
        type: "GET",
        dataType: "html",

        success: function (response) {
            $("#content").html(response);
        },

        error: function () {
            $("#content").html(
                "<p>Error loading content.</p>"
            );
        }
    });

}

